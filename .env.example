# Names only. Never commit values. Copy to .env.local for the Vite app.
# --- Browser (Vite) ---
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# --- Edge functions (set in Supabase dashboard -> Edge Functions -> Secrets; never in this repo) ---
# SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY are injected by Supabase automatically.
# CRON_SECRET             must equal the Vault secret named cron_secret (see README)
# TIDESATLAS_API_KEY      tidesatlas.com/api/register; missing -> tidal layer reports "not configured"
# --- Briefing model backend (generate-briefing) ---
# BRIEFING_PROVIDER       "anthropic" (default) or "openai" for any OpenAI-compatible gateway
# BRIEFING_PROMPT_VERSION default v1
# BRIEFING_MODEL          anthropic: default claude-opus-5. openai: the gateway's model id (required)
#   Anthropic path:
# ANTHROPIC_API_KEY       console.anthropic.com; missing -> "Briefing unavailable: ANTHROPIC_API_KEY not set"
#   OpenAI-compatible path (set BRIEFING_PROVIDER=openai), e.g. Synthetic / z.ai / OpenRouter:
# BRIEFING_BASE_URL       e.g. https://api.synthetic.new/openai/v1  (or https://api.z.ai/api/paas/v4)
# BRIEFING_API_KEY        the gateway key; missing -> briefing unavailable with a clear reason
#   e.g. Synthetic GLM/Kimi: BRIEFING_PROVIDER=openai, BRIEFING_BASE_URL=https://api.synthetic.new/openai/v1,
#        BRIEFING_MODEL=hf:zai-org/GLM-4.6 (pick the exact id from the gateway's /models)
# WORLDTIDES_API_KEY      optional fallback tidal provider
